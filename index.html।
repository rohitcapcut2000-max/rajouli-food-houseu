
<!DOCTYPE html>
<html lang="hi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Rajoli Food House</title>
  <style>
    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: #fff8f0;
      color: #222;
    }
    header {
      background: #b83220;
      color: white;
      padding: 22px;
      text-align: center;
    }
    .menu {
      padding: 15px;
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
    }
    .food {
      background: white;
      padding: 12px;
      border-radius: 12px;
      box-shadow: 0 2px 8px #ddd;
    }
    .food img {
      width: 100%;
      height: 110px;
      object-fit: cover;
      border-radius: 8px;
    }
    button {
      background: #168447;
      color: white;
      border: 0;
      padding: 10px;
      border-radius: 7px;
      width: 100%;
      margin-top: 8px;
    }
    #cart {
      background: white;
      margin: 15px;
      padding: 15px;
      border-radius: 12px;
    }
    input, textarea {
      box-sizing: border-box;
      width: 100%;
      padding: 11px;
      margin: 6px 0;
    }
  </style>
</head>
<body>

<header>
  <h1>Rajoli Food House</h1>
  <p>स्वादिष्ट खाना, आपके घर तक!</p>
</header>

<h2 style="padding-left:15px">हमारा मेन्यू</h2>

<div class="menu" id="menu"></div>

<div id="cart">
  <h2>आपका Cart</h2>
  <div id="items">अभी Cart खाली है</div>
  <h3 id="total">कुल: ₹0</h3>

  <h3>डिलीवरी की जानकारी</h3>
  <input id="customer" placeholder="आपका नाम">
  <input id="phone" placeholder="मोबाइल नंबर" inputmode="numeric">
  <textarea id="address" placeholder="पूरा डिलीवरी पता"></textarea>

  <button onclick="sendOrder()">WhatsApp पर ऑर्डर करें</button>
</div>

<script>
const foods = [
  {name:"Burger", price:80,
   image:"https://images.unsplash.com/photo-1568901346375-23c9450c58cd?w=400"},
  {name:"Pizza", price:150,
   image:"https://images.unsplash.com/photo- pizza?w=400"},
  {name:"Chowmein", price:70,
   image:"https://images.unsplash.com/photo-1585032226651-759b368d7246?w=400"},
  {name:"Thali", price:120,
   image:"https://images.unsplash.com/photo-1546833999-b9f581a1996d?w=400"}
];

let cart = [];

function showMenu() {
  document.getElementById("menu").innerHTML =
    foods.map((food, i) => `
      <div class="food">
        <img src="${food.image}" alt="${food.name}">
        <h3>${food.name}</h3>
        <p>₹${food.price}</p>
        <button onclick="addToCart(${i})">Add to Cart</button>
      </div>
    `).join("");
}

function addToCart(index) {
  const found = cart.find(item => item.name === foods[index].name);
  if (found) found.qty++;
  else cart.push({...foods[index], qty:1});
  showCart();
}

function showCart() {
  const items = document.getElementById("items");
  items.innerHTML = cart.length
    ? cart.map(item =>
      `<p>${item.name} × ${item.qty} = ₹${item.price * item.qty}</p>`
    ).join("")
    : "अभी Cart खाली है";

  const total = cart.reduce(
    (sum, item) => sum + item.price * item.qty, 0
  );
  document.getElementById("total").innerText = "कुल: ₹" + total;
}

function sendOrder() {
  const name = document.getElementById("customer").value.trim();
  const phone = document.getElementById("phone").value.trim();
  const address = document.getElementById("address").value.trim();

  if (!cart.length) return alert("पहले खाना चुनें");
  if (!name || !phone || !address)
    return alert("कृपया पूरी जानकारी भरें");

  const total = cart.reduce(
    (sum, item) => sum + item.price * item.qty, 0
  );

  const order = cart.map(item =>
    `${item.name} x ${item.qty} = Rs.${item.price * item.qty}`
  ).join("\n");

  const message =
    `नया ऑर्डर\nनाम: ${name}\nफोन: ${phone}\nपता: ${address}\n\n${order}\nकुल: Rs.${total}`;

  const restaurantNumber = "91XXXXXXXXXX";
  window.open(
    "https://wa.me/" + restaurantNumber +
    "?text=" + encodeURIComponent(message),
    "_blank"
  );
}

showMenu();
</script>

</body>
</html>
